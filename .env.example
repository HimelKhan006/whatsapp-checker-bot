# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram Admin User IDs (Comma-separated for multiple admins)
# Get your Telegram ID using @userinfobot
ADMIN_IDS=6798979733

# Default Access Mode: 'authorized' (Admin approves users) | 'public' | 'private' (Admin only)
BOT_MODE=authorized

# Rate limiting delay between WhatsApp checks (in milliseconds)
CHECK_DELAY_MS=0

# Maximum numbers allowed per bulk check batch
MAX_BULK_LIMIT=5000

# Security Encryption Key (32-character secret string for AES-256-GCM data encryption)
ENCRYPTION_KEY=my_super_secret_encryption_key_32chars!

# GitHub Gist Cloud Sync (For zero data loss on Render / Cloud deploys)
GITHUB_GIST_TOKEN=ghp_YourGitHubPersonalAccessToken
GIST_ID=your_gist_id_hex_string
